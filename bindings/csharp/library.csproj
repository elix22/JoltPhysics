<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 for broad compatibility; net10.0 to include extras/ which
         requires [UnmanagedCallersOnly] and delegate* unmanaged (net5+ only). -->
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS0659;CS0661</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude the tests subfolder from all targets. -->
    <Compile Remove="tests/**/*.cs" />
    <!-- extras/ uses [UnmanagedCallersOnly] and delegate* unmanaged (net5+ only).
         Exclude from netstandard2.0; the net10.0 target includes them. -->
    <Compile Remove="extras/**/*.cs" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>

</Project>
